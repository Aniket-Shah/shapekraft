# GTM/GA4 IDs are public (they ship in every page's HTML), so real values are fine here.
# Same single Vercel project serves both domains — market is detected from the request's
# Host header (see src/lib/market.ts), so set all four vars on the one deployment.

NEXT_PUBLIC_GTM_ID_IN=GTM-5VMWSZQV
NEXT_PUBLIC_GA_ID_IN=G-9S3K9SRX08

NEXT_PUBLIC_GTM_ID_CO=GTM-TQZS6VJP
NEXT_PUBLIC_GA_ID_CO=G-FJC0NPT2X7

# Quote-builder lead delivery (/api/lead). Server-only secrets: set in the hosting dashboard.
# Option A: email via Resend
RESEND_API_KEY=
LEAD_TO_EMAIL=
LEAD_FROM_EMAIL=
# Option B: any JSON webhook (e.g. https://formsubmit.co/ajax/you@example.com, Zapier, Make)
LEAD_RELAY_URL=

# ── Quote Desk (see docs/desk-setup.md) ──
DESK_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_OWNER_CHAT_ID=
DESK_SHEET_URL=
DESK_SHEET_TOKEN=
BREVO_API_KEY=
DESK_FROM_EMAIL=ShapeKraft <hello@shapekraft.co>
ANTHROPIC_API_KEY=
DESK_MODEL=claude-haiku-5-5
